{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Rich media (images / audio / video) inline in chat.",
  "authors": [
    "chat-upgrade"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.chat.upgrade.fabric.ChatUpgradeFabric"
    ],
    "client": [
      "com.chat.upgrade.fabric.ChatUpgradeClientFabric"
    ],
    "preLaunch": [
      "com.chat.upgrade.fabric.ChatUpgradeAwtBootstrapFabric"
    ]
  },
  "mixins": [
    "chatupgrade.mixins.json",
    {
      "config": "chatupgrade.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  }
}
